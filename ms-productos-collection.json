{
  "info": {
    "name": "ms-productos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "producto_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GET - Listar productos activos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/productos",
          "host": ["{{base_url}}"],
          "path": ["api", "productos"]
        }
      }
    },
    {
      "name": "GET - Buscar producto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/productos/{{producto_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "productos", "{{producto_id}}"]
        }
      }
    },
    {
      "name": "POST - Crear producto (Laptop)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop Dell Inspiron 15\",\n  \"price\": 2500.00,\n  \"stock\": 20\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/productos",
          "host": ["{{base_url}}"],
          "path": ["api", "productos"]
        }
      }
    },
    {
      "name": "POST - Crear producto (Mouse)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mouse Logitech MX Master 3\",\n  \"price\": 350.00,\n  \"stock\": 50\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/productos",
          "host": ["{{base_url}}"],
          "path": ["api", "productos"]
        }
      }
    },
    {
      "name": "POST - Crear producto (Teclado)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teclado Mecanico Redragon K552\",\n  \"price\": 180.00,\n  \"stock\": 30\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/productos",
          "host": ["{{base_url}}"],
          "path": ["api", "productos"]
        }
      }
    },
    {
      "name": "PUT - Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop Dell Inspiron 15 actualizado\",\n  \"price\": 2350.00,\n  \"stock\": 18\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/productos/{{producto_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "productos", "{{producto_id}}"]
        }
      }
    },
    {
      "name": "PATCH - Reducir stock",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/productos/{{producto_id}}/decreaseStock?quantity=3",
          "host": ["{{base_url}}"],
          "path": ["api", "productos", "{{producto_id}}", "decreaseStock"],
          "query": [
            { "key": "quantity", "value": "3" }
          ]
        }
      }
    },
    {
      "name": "DELETE - Eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/productos/{{producto_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "productos", "{{producto_id}}"]
        }
      }
    }
  ]
}
